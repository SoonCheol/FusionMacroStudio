{
  "name": "fusion-macro-studio",
  "version": "0.4.10",
  "description": "Fusion Macro Studio Windows editor",
  "author": "Fusion Macro Studio",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "net.fusionmacrostudio.editor",
    "productName": "Fusion Macro Studio",
    "artifactName": "FusionMacroStudio-Setup-${version}.${ext}",
    "files": [
      "main.cjs",
      "preload.cjs",
      "storage.cjs",
      "site/**",
      "package.json",
      "assets/app-icon.png",
      "addin-release.cjs"
    ],
    "extraResources": [
      {
        "from": "addin-package",
        "to": "addin-package"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "icon": "build/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/app-icon.ico",
      "uninstallerIcon": "build/app-icon.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://sooncheol.github.io/FusionMacroStudio/downloads/desktop/"
      }
    ]
  }
}
